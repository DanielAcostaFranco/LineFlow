# Use a local MongoDB instance or provide a managed MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lineflow

# Use a private random secret of at least 32 characters and the public app URL.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5173

# Optional: set both values to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
